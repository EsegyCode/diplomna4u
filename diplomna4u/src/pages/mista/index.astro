---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { cities } from '@/data/cities';
const ready = cities.filter(c => c.localContentReady);
---
<BaseLayout title="Де ми працюємо — дипломні й курсові по всій Україні" description="Diplomna 4 U працює дистанційно по всій Україні. Обери своє місто — подивись університети, ціни й умови замовлення дипломної чи курсової.">
  <Section theme="bg">
    <Breadcrumbs items={[{label:'Головна', href:'/'}, {label:'Міста'}]} />
    <h1>Де ми працюємо</h1>
    <p>Працюємо дистанційно по всій Україні: заявка, договір, оплата й передача роботи — онлайн. Обери своє місто, щоб побачити університети й умови.</p>
    {ready.length === 0 ? (
      <p class="text-muted">Сторінки міст ще готуються. Поки що ми працюємо з усіма містами України — напиши нам у Telegram або залиш заявку.</p>
    ) : (
      <ul class="city-list">
        {ready.map(c => <li><a href={`/${c.slug}/`}>{c.name}</a> — Дипломна робота {c.inCity} · <a href={`/${c.slug}/`}>Докладніше →</a></li>)}
      </ul>
    )}
    <p style="margin-top:1rem">Не бачиш свого міста? Ми працюємо дистанційно, тож це не завада. <a href="/#quick-order">Залиш заявку</a> — і ми підкажемо, як усе відбуватиметься.</p>
    <p><a href="/universytety/">Університети →</a></p>
  </Section>
</BaseLayout>
<style>
  .city-list { list-style: disc; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; }
</style>
