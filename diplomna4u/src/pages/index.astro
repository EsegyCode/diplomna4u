---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import WaveDivider from '@/components/WaveDivider.astro';
import Hero from '@/components/Hero.astro';
import QuickOrder from '@/components/QuickOrder.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import ServicesGrid from '@/components/ServicesGrid.astro';
import SectionLinkCards from '@/components/SectionLinkCards.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import PricingTeaser from '@/components/PricingTeaser.astro';
import FAQ from '@/components/FAQ.astro';
import CitiesTeaser from '@/components/CitiesTeaser.astro';
import LeadForm from '@/components/LeadForm.astro';
import { pricing } from '@/data/pricing';
import { faqGeneral } from '@/data/faq';
import { site } from '@/data/site';

const minPrice = pricing.workTypes.find(w => w.slug === 'dyplomna-robota')?.minPrice ?? 0;
const stepTexts = [
  'Залишаєш заявку або рахуєш вартість',
  'Менеджер уточнює деталі і узгоджує договір',
  'Передплата 50% і початок роботи',
  'Отримуєш готову роботу, сертифікат антиплагіату',
];
const introFacts = [
  'Мінімальний термін дипломної — від 3 днів',
  'Реальні дані з дослідних полів + консультації викладачів',
  'Унікальність 85%+ (за бажанням 90%+), сертифікат антиплагіату',
  'Безкоштовні правки протягом місяця',
  'Оплата 2 етапами: 50% + 50%',
];
const sectionCards = [
  { title: 'Ціни', desc: 'Калькулятор онлайн і повна таблиця цін', href: '/tsiny/' },
  { title: 'Відгуки', desc: 'Що кажуть наші клієнти', href: '/vidhuky/' },
  { title: 'Блог', desc: 'Корисні матеріали для студентів', href: '/blog/' },
  { title: 'Про нас', desc: 'Хто ми і як працюємо', href: '/pro-nas/' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Diplomna 4 U', url: 'https://diplomna4u.cx.ua', email: 'diplomna4u@gmail.com' },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Diplomna 4 U', url: 'https://diplomna4u.cx.ua' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqGeneral.slice(0,6).map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<BaseLayout title={`Diplomna 4 U — дипломна робота для тебе | від ${minPrice} грн`} description="Допомога з дипломною, курсовою та статтею по всій Україні. Калькулятор ціни онлайн, безкоштовна консультація." jsonLd={jsonLd}>
  <Section theme="bg">
    <Hero title="Дипломна робота для тебе" subtitle="Швидко, офіційно, з консультаціями викладачів-спеціалістів. Дізнайся вартість за 2 хвилини." badgePrice={String(minPrice)}>
      <QuickOrder variant="hero" />
    </Hero>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="surface">
    <TrustStrip items={introFacts} />
    <div style="margin-top:1.5rem"><ServicesGrid /></div>
  </Section>
  <WaveDivider variant="drop" />

  <Section theme="invert">
    <h2 style="text-align:center">Розділи сайту</h2>
    <SectionLinkCards items={sectionCards} />
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="bg">
    <h2 id="how" style="margin-bottom:1.5rem">Як ми працюємо</h2>
    <HowItWorks steps={stepTexts} />
  </Section>
  <WaveDivider variant="drop" />

  <Section theme="sage">
    <div style="display:grid;gap:2rem">
      <div>
        <h2 style="margin-bottom:1rem">Ціни</h2>
        <PricingTeaser />
        <p style="margin-top:0.75rem"><a href="/tsiny/" class="btn btn--ghost">Детальніше про ціни →</a></p>
      </div>
      <QuickOrder variant="compact" />
    </div>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="invert">
    <h2 style="text-align:center;margin-bottom:1.5rem">Відгуки</h2>
    <p class="text-muted" style="text-align:center">TODO: відгуки додасть власник.</p>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="bg">
    <h2 id="faq" style="margin-bottom:1.5rem">Часті запитання</h2>
    <FAQ items={faqGeneral} limit={6} />
    <div style="margin-top:2rem">
      <CitiesTeaser />
    </div>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="invert">
    <h2 style="text-align:center;margin-bottom:0.5rem">Готовий почати?</h2>
    <p style="text-align:center;margin-bottom:1.5rem">Залиш заявку — ми проконсультуємо безкоштовно</p>
    <div style="max-width:600px;margin:0 auto">
      <LeadForm variant="compact" source="home" />
    </div>
    <p style="text-align:center;margin-top:1rem">
      {site.telegram && <a href={site.telegram.url} target="_blank" rel="noopener noreferrer" class="btn">Написати в Telegram</a>}
    </p>
  </Section>
</BaseLayout>
