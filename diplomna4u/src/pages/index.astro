---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import WaveDivider from '@/components/WaveDivider.astro';
import Hero from '@/components/Hero.astro';
import QuickOrder from '@/components/QuickOrder.astro';
import TrustStrip from '@/components/TrustStrip.astro';
import ServicesGrid from '@/components/ServicesGrid.astro';
import ReviewCard from '@/components/ReviewCard.astro';
import ReviewsGrid from '@/components/ReviewsGrid.astro';
import { getCollection } from 'astro:content';
import HowItWorks from '@/components/HowItWorks.astro';
import PricingTeaser from '@/components/PricingTeaser.astro';
import FAQ from '@/components/FAQ.astro';
import CitiesTeaser from '@/components/CitiesTeaser.astro';
import LeadForm from '@/components/LeadForm.astro';
import { faqGeneral } from '@/data/faq';
import { heroCopy } from '@/data/heroCopy';

// placeholder-відгуки замінюються вручну у src/content/reviews
const reviews = await getCollection('reviews');
const homeReviews = reviews.sort((a, b) => +new Date(b.data.date) - +new Date(a.data.date)).slice(0, 3);
const stepTexts = [
  'Залишаєш заявку або рахуєш вартість',
  'Менеджер уточнює деталі і узгоджує договір',
  'Передплата 50% і початок роботи',
  'Отримуєш готову роботу, сертифікат антиплагіату',
];
const introFacts = [
  'Мінімальний термін дипломної — від 3 днів',
  'Унікальність 85–90%, сертифікат антиплагіату',
  'Безкоштовні правки протягом місяця',
  'Оплата 2 етапами: 50% + 50%',
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqGeneral.slice(0,6).map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<BaseLayout title="Diplomna 4 U — дипломна робота для тебе | від 14 800 грн" description="Дипломні, курсові, статті, реферати та звіти з практики. Дипломна від 3 днів, унікальність 85–90%, правки місяць безкоштовно. Порахуй ціну онлайн." jsonLd={jsonLd}>
  <Section theme="bg" class="hero-section">
    <Hero title="Дипломна робота для тебе" subtitle="Швидко, анонімно, з консультаціями викладачів та фахових спеціалістів." description={heroCopy.paragraphs} bullets={heroCopy.bullets}>
      <QuickOrder variant="hero" dark />
    </Hero>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="sage">
    <TrustStrip items={introFacts} />
  </Section>
  <Section theme="surface">
    <div style="margin-top:2rem"><ServicesGrid /></div>
  </Section>
  <WaveDivider variant="drop" />
  <Section theme="surface">
    <div class="seo-blocks">
      <section class="seo-block seo-block--intro" aria-labelledby="seo-heading">
        <h2 id="seo-heading" class="seo-block__title">Дипломні, курсові, статті та звіти на замовлення</h2>
        <p>На сайті представлено послуги з підготовки дипломних, курсових, наукових статей, тез, рефератів, звітів з практики та презентацій для захисту. Працюємо з різними напрямами підготовки: від гуманітарних і економічних до природничих, аграрних та технічних спеціальностей. Замовити дипломну роботу, ціна Україна: вартість формується залежно від обсягу, терміну та складності теми, а дипломна є доступною від 3 днів за термінового замовлення.</p>
        <p>Співпраця починається з короткої заявки на сайті або в Telegram. Менеджер уточнює обраний тип роботи, тему, вимоги кафедри, бажаний обсяг і термін, після чого узгоджує перелік розділів і орієнтовну вартість. Вже на старті фіксуємо план і етапи, щоб робота просувалася передбачувано. Курсова робота на замовлення, ціна якої залежить від напрямку й складності.</p>
        <p>Перед замовленням варто повідомити бажаний термін, тему або напрям, очікуваний обсяг і форму навчання. Якщо маєте власні матеріали, приклади минулих робіт чи базу даних — надішліть їх разом із темою. Якщо тема ще уточнюється, опишіть головне питання дослідження й бажаний результат: менеджер допоможе сформулювати технічне завдання. Повний стартовий пакет допомагає точніше розрахувати ціну та отримати текст, наближений до ваших очікувань.</p>
        <p>Якщо тема складна або міждисциплінарна, опишіть очікуваний результат і критерії оцінювання — це допомагає підібрати правильну структуру, джерела й методи дослідження ще до початку роботи.</p>
      </section>
      <section class="seo-block seo-block--inverted" aria-labelledby="seo-specialties">
        <h2 id="seo-specialties" class="seo-block__title">Профільні спеціальності</h2>
        <p>Наша ніша: природничі й аграрні напрями, де важлива практична частина і робота з реальними даними. Дипломна робота з агрономії зазвичай містить аналіз господарства, розрахунки врожайності, сівозмін і заходи захисту посівів. Дипломна робота з екології поєднує оцінку стану довкілля, аналіз впливу виробництва і рекомендації зі зменшення навантаження. Дипломна робота з біології та біохімії передбачає огляд літератури, методи дослідження, результати експерименту й статистичну обробку. Дипломна робота з ветеринарної медицини описує клінічні випадки, діагностику, лікування і профілактику захворювань.</p>
        <p>Дипломна робота з геодезії та землеустрою містить розрахунки, аналіз землекористування й особливості місцевості. Дипломна робота з харчових технологій описує рецептури, технологічні схеми, контроль якості і відповідність стандартам. Дипломна робота з туризму та рекреації включає аналіз ресурсів, маршрути, економічне обґрунтування й маркетингові рішення. Курсова робота з лісового або садово-паркового господарства може містити інвентаризацію насаджень, оцінку стану території і рекомендації з догляду. Усі ці напрями ми виконуємо за вимогами кафедри, підбираючи джерела під конкретну тему.</p>
      </section>
      <section class="seo-block" aria-labelledby="seo-articles">
        <h2 id="seo-articles" class="seo-block__title">Наукові статті, тези, звіти з практики та презентації</h2>
        <p>Написання наукових статей та тез на замовлення допомагає підготувати короткий, але змістовний матеріал для публікації або виступу. Стаття починається від семи сторінок і включає аналіз джерел, власні висновки та оформлення за вимогами видання. Тези зазвичай готують до п'яти сторінок для конференції, з чіткою структурою й обґрунтуванням основного положення. Звіт з практики на замовлення, ціна якого залежить від обсягу й терміну, поєднує характеристику підприємства, опис обов'язків, щоденник практики, висновки й необхідні документи.</p>
        <p>Ми узгоджуємо детальний перелік розділів із методичкою, щоб відповідати вимогам кафедри. Презентація до захисту диплома замовити можна як допоміжний матеріал: візуальне супроводження доповіді з головними тезами, таблицями і висновками. Вона допомагає зосередитись під час захисту і зробити виступ логічнішим. Презентацію можна замовити окремо або разом із дипломною чи курсовою роботою, що економить час на підготовку.</p>
        <p>Для прискорення роботи над статтею корисно надати вимоги видання, обсяг і ключові слова заздалегідь: тоді структура узгоджується швидше, а текст відразу відповідає формату публікації.</p>
      </section>
      <section class="seo-block" aria-labelledby="seo-method">
        <h2 id="seo-method" class="seo-block__title">Як ми працюємо з вимогами методички та керівника</h2>
        <p>Перед початком роботи ми узгоджуємо не лише тему, а й побажання керівника: структуру, обсяг, стиль і термінологію, вимоги до таблиць, графіків і додатків. Це зменшує кількість доробок і робить роботу ближчою до очікуваного оцінювання. Методичні вказівки кафедри можуть бути надіслані у форматі PDF або посилання: ми перевіряємо рекомендовану структуру, вимоги до списку літератури, оформлення заголовків, таблиць і додатків.</p>
        <p>Якщо методичка надходить пізніше, правки інтегруються в процес без переробки всієї роботи, коли це можливо. Робота з високою унікальністю антиплагіат має враховувати нові джерела, тому додаткова перевірка проводиться після кожної істотної зміни плану. Зміна теми чи коригування вимог під час виконання — типова ситуація: менеджер фіксує нові побажання, оцінює обсяг змін і погоджує, як вони впливають на термін. Ми стараємося зробити процес гнучким, але зберегти зафіксовані терміни для вже виконаних частин.</p>
        <p>Відгуки та пропозиції коригуються на проміжних етапах, щоб перед фінальною здачею в тексті не залишалося суперечностей. Якщо викладач вносить зауваження по змісту, їх можна відпрацювати в межах узгоджених правок. Це дозволяє підготувати роботу до захисту без хаотичних доопрацювань в останній день.</p>
        <p>Узгодження відбувається етапами: після кожної частини ви можете перевірити текст і внести побажання до фінальної версії, тож зауваження не накопичуються.</p>
      </section>
      <section class="seo-block seo-block--inverted" aria-labelledby="seo-remote">
        <h2 id="seo-remote" class="seo-block__title">Дистанційна робота по Україні</h2>
        <p>Ми працюємо дистанційно по всій Україні: документи, договір, оплата і передача готових файлів відбуваються онлайн. Це зручно для студентів з Сум, Києва, Львова, Харкова, Дніпра, Одеси та інших міст, незалежно від форми навчання. Замовити дипломну роботу в Сумах або для іншого міста можна без візиту в офіс: усі обговорення відбуваються через Telegram і електронну пошту, а за потреби — телефоном у робочий час.</p>
        <p>Для регіональних завдань ми враховуємо специфіку місцевих університетів та підприємств, коли це потрібно для практичної частини. Якщо тема прив'язана до конкретного господарства, регіону чи нормативної бази, надішліть посилання або матеріали — ми використаємо їх у роботі. Розрахунок вартості займає кілька хвилин у калькуляторі, а менеджер допомагає уточнити деталі і підготувати договір. Такий формат особливо зручний для студентів заочної та дистанційної форми навчання.</p>
      </section>
      <section class="seo-block" aria-labelledby="seo-antiplag">
        <h2 id="seo-antiplag" class="seo-block__title">Перевірка на антиплагіат та оформлення</h2>
        <p>Перевірка на антиплагіат проводиться для кожної роботи, а сертифікат антиплагіату видається разом із готовим текстом. Стандартний рівень унікальності становить 85% і вище, за додаткову оплату можна підійти до 90% і вище. Ми не обіцяємо нереалістичних показників, лише фіксуємо результат перевірки для конкретного документа.</p>
        <p>Оформлення виконується за методичними вказівками кафедри: шрифт, інтервали, поля, нумерація, оформлення таблиць і рисунків. Якісне оформлення економить час при перевірці і зменшує кількість технічних зауважень. Бібліографічний список підбирається з актуальних джерел і впорядковується за вимогами. Перевірка перед здачею включає контроль логіки розділів, відповідність плану й узгодженість висновків з метою роботи. Правки протягом першого місяця надаються за умовами замовлення, тому ми рекомендуємо одразу передавати зауваження від керівника.</p>
        <p>Після здачі роботи зберігайте звіт перевірки й коментарі викладача: вони стануть основою для уточнень і допоможуть відстежити, що вже виправлено.</p>
      </section>
    </div>
  </Section>

  <Section theme="blood">
    <h2 id="how" style="margin-bottom:1.5rem; text-align:left">Як ми працюємо</h2>
    <HowItWorks steps={stepTexts} />
  </Section>
  <WaveDivider variant="drop" />

  <Section theme="surface">
    <div>
      <h2 style="margin-bottom:1rem">Ціни</h2>
      <PricingTeaser />
      <p style="margin-top:0.75rem"><a href="/tsiny/" class="btn">Детальніше про ціни →</a></p>
    </div>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="sage">
    <h2 class="text-center" style="margin-bottom:1.5rem">Відгуки</h2>
    {homeReviews.length === 0 ? (
      <p style="text-align:center;color:var(--vanilla);opacity:0.85">Відгуки з'являться після наповнення.</p>
    ) : (
      <ReviewsGrid>
        {homeReviews.map(r => (
          <ReviewCard name={r.data.name} workType={r.data.workType} rating={r.data.rating} text={r.data.text} city={r.data.city} date={r.data.date.toLocaleDateString('uk-UA')} />
        ))}
      </ReviewsGrid>
    )}
    <div style="text-align:center;margin-top:1.5rem">
      <a href="/vidhuky/" class="btn btn--reviews">Читати відгуки →</a>
    </div>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="bg">
    <h2 id="faq" style="margin-bottom:1.5rem">Часті запитання</h2>
    <FAQ items={faqGeneral} limit={6} />
    <div style="margin-top:2rem">
      <CitiesTeaser />
    </div>
  </Section>
  <WaveDivider variant="wave" />

  <Section theme="surface">
    <h2 class="text-center" style="margin-bottom:0.5rem">Готовий почати?</h2>
    <p style="text-align:center;margin-bottom:1.5rem">Залиш заявку — ми безкоштовно проконсультуємо</p>
    <div style="max-width:560px;margin:0 auto">
      <LeadForm variant="compact" source="home" />
    </div>
  </Section>
</BaseLayout>
