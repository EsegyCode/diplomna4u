---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import WaveDivider from '@/components/WaveDivider.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuickOrder from '@/components/QuickOrder.astro';
import PricingTable from '@/components/PricingTable.astro';
import FAQ from '@/components/FAQ.astro';
import LeadForm from '@/components/LeadForm.astro';
import { faqPrices } from '@/data/faq';
---
<BaseLayout title="Ціни на дипломі, курсові, статті та реферати | Diplomna 4 U" description="Прейскурант Diplomna 4 U: дипломна від 15 000 грн, курсова від 3 250 грн, реферат від 960 грн, стаття від 460 грн. Калькулятор вартості онлайн.">
  <Section theme="bg">
    <Breadcrumbs items={[{label:'Головна', href:'/'}, {label:'Ціни'}]} />
    <h1>Ціни на роботи</h1>
    <p>Ціни вказано «від». Остаточна вартість залежить від напряму, обсягу й терміну здачі. Порахуй її в калькуляторі — це займає 2 хвилини й ні до чого не зобов’язує.</p>
    <QuickOrder variant="page" />
  </Section>
  <WaveDivider />
  <Section theme="surface">
    <h2>Таблиця цін</h2>
    <PricingTable />
  </Section>
  <WaveDivider />
  <Section theme="bg">
    <h2>FAQ по цінах</h2>
    <FAQ items={faqPrices} />
  </Section>
  <WaveDivider />
  <Section theme="invert">
    <h2 style="text-align:center">Залишити заявку</h2>
    <div style="max-width:600px;margin:0 auto"><LeadForm variant="page" source="prices" /></div>
  </Section>
</BaseLayout>
