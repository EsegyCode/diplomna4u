---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import WaveDivider from '@/components/WaveDivider.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import LocalUniversities from '@/components/LocalUniversities.astro';
import OtherCities from '@/components/OtherCities.astro';
import FAQ from '@/components/FAQ.astro';
import LeadForm from '@/components/LeadForm.astro';
import QuickOrder from '@/components/QuickOrder.astro';
import { cities } from '@/data/cities';
import { faqGeneral } from '@/data/faq';
import { stats } from '@/data/stats';
import { pricing } from '@/data/pricing';
import { fill } from '@/utils/template';

export function getStaticPaths() {
  return cities.map(c => ({ params: { city: c.slug }, props: { city: c } }));
}
const { city } = Astro.props as { city: (typeof cities)[number] };
const noindex = !city.localContentReady;
const title = fill('Дипломна робота {inCity}: від {price} грн | {brand}', city);
const description = `Допомога з дипломною, курсовою та статтею ${city.inCity}. Університети міста, спеціальності, калькулятор ціни онлайн.`;
const faqItems = city.localFaq.length ? city.localFaq : faqGeneral.slice(0, 4);
const hasSpecialties = city.universities.some(u => u.specialties?.length);
const usefulLinks = [
  { title: 'Ціни', desc: 'Прейскурант і таблиця вартості всіх видів робіт', href: '/tsiny/' },
  { title: 'Відгуки', desc: 'Що кажуть студенти, які вже замовляли', href: '/vidhuky/' },
  { title: 'Дипломна робота', desc: 'Повний цикл: від теми до захисту', href: '/poslugy/dyplomna-robota/' },
  { title: 'Курсова робота', desc: 'Теорія, практика й оформлення за методичкою', href: '/poslugy/kursova-robota/' },
  { title: 'Стаття', desc: 'Наукова стаття з аналізом джерел і оформленням за вимогами видання', href: '/poslugy/stattia/' },
  { title: 'Про нас', desc: 'Хто ми і як працюємо за договором', href: '/pro-nas/' },
  { title: 'Інші міста', desc: 'Усі міста, де ми працюємо', href: '/mista/' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Дипломна робота', areaServed: { '@type': 'City', name: city.name } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Головна', item: 'https://diplomna4u.cx.ua/' },
    { '@type': 'ListItem', position: 2, name: 'Де ми працюємо', item: 'https://diplomna4u.cx.ua/mista/' },
    { '@type': 'ListItem', position: 3, name: city.name, item: `https://diplomna4u.cx.ua/${city.slug}/` },
  ] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map(it => ({
    '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a },
  })) },
];
function spec(key: string) { return pricing.specialties.find(s => s.key === key); }
---

<BaseLayout title={title} description={description} noindex={noindex} jsonLd={jsonLd}>
  <Section theme="bg">
    <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Де ми працюємо', href: '/mista/' }, { label: city.name }]} />
    <h1>Замовити дипломну роботу {city.inCity}</h1>
    <p class="city-lead-line">{city.region}. Допомога з дипломними, курсовими та статтями.</p>
    {city.intro && <p class="city-intro">{city.intro}</p>}
    <p class="city-intro">Працюємо за договором: заявка, узгодження вимог кафедри, передплата 50% і здача готової роботи. Сертифікат антиплагіату до кожної роботи, безкоштовні правки протягом місяця, мінімальний термін дипломної: від 3 днів.</p>
    {city.localFacts.length > 0 && (
      <ul class="city-facts">
        {city.localFacts.map(f => <li>{f}</li>)}
      </ul>
    )}
    <div style="margin-top:2rem">
      <a href="#quick-order" class="btn">Дізнатись вартість →</a>
    </div>
  </Section>
  <WaveDivider />
  <Section theme="bg" id="quick-order">
    <h2>Калькулятор вартості</h2>
    <QuickOrder variant="compact" headingLevel="h3" />
  </Section>
  <WaveDivider />
  <Section theme="surface">
    <h2>Університети, студентам яких ми допомагали {city.inCity}</h2>
    <LocalUniversities universities={city.universities} />
    <p class="uni-note">Працюємо зі студентами перелічених закладів і готуємо роботу за методичкою кафедри. Не є партнерами чи представниками університетів.</p>
  </Section>
  {hasSpecialties && (
    <>
      <WaveDivider />
      <Section theme="bg">
        <h2>Спеціальності, за якими пишемо роботи {city.inCity}</h2>
        {city.universities.filter(u => u.specialties?.length).map(u => (
          <div class="uni-specialties">
            <h3>{u.name}{u.short ? ` (${u.short})` : ''}</h3>
            <div class="specialty-grid">
              {(u.specialties || []).map(key => {
                const s = spec(key);
                const programs = u.programs?.[key];
                return s && (
                  <article class="specialty-card">
                    <span class="specialty-badge">{s.code} ({s.legacyCode})</span>
                    <h4>{s.name}</h4>
                    {programs?.length && <p class="text-muted">{programs.join('; ')}</p>}
                    <button type="button" class="btn btn--sm" data-pick-specialty={key}>Замовити роботу</button>
                  </article>
                );
              })}
            </div>
          </div>
        ))}
      </Section>
    </>
  )}
  <WaveDivider />
  <Section theme="surface">
    <h2>Наш досвід у цифрах</h2>
    {stats.showStats && (
      <div class="city-stats">
        <div class="city-stat"><span>{stats.completed.diploma}</span> дипломних</div>
        <div class="city-stat"><span>{stats.completed.coursework}</span> курсових</div>
        <div class="city-stat"><span>{stats.completed.theses}</span> тез</div>
        <div class="city-stat"><span>{stats.completed.articles}</span> статей</div>
        <div class="city-stat"><span>{stats.completed.practiceReports}</span> звітів</div>
        <div class="city-stat"><span>з {stats.foundedYear}</span> року</div>
        <div class="city-stat"><span>{stats.teamSize}</span> співробітники</div>
      </div>
    )}
  </Section>
  <WaveDivider />
  <Section theme="surface">
    <h2>Корисні розділи</h2>
    <div class="useful-grid">
      {usefulLinks.map(l => (
        <a href={l.href} class="useful-card">
          <span class="useful-title">{l.title} →</span>
          <span class="useful-desc">{l.desc}</span>
        </a>
      ))}
    </div>
  </Section>
  <WaveDivider />
  <Section theme="surface">
    <h2>Часті запитання</h2>
    <FAQ items={faqItems} limit={6} />
  </Section>
  <WaveDivider />
  <Section theme="invert">
    <h2 class="text-center" style="text-align:center;margin-bottom:2rem">Готовий почати?</h2>
    <div style="max-width:600px;margin:0 auto">
      <LeadForm variant="page" source="city" city={city.slug} />
    </div>
  </Section>
  <WaveDivider />
  <Section theme="bg">
    <OtherCities current={city.slug} />
  </Section>
</BaseLayout>

<script>
  document.querySelectorAll('[data-pick-specialty]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-pick-specialty');
      const select = document.querySelector('[data-specialty-select]');
      if (key && select) {
        select.value = key;
        select.dispatchEvent(new Event('change', { bubbles: true }));
      }
      document.getElementById('quick-order')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  h2 { margin-bottom: 1.5rem; }
  .city-lead-line { font-size: var(--fs-lead); line-height: 1.6; font-weight: 600; color: var(--ink); margin-top: 2rem; margin-bottom: 1rem; max-width: 60ch; }
  .city-intro { font-size: var(--fs-lead); line-height: 1.6; max-width: 60ch; margin: 0 0 1.25rem; color: var(--ink); }
  .uni-note { font-size: var(--fs-lead); line-height: 1.6; color: var(--ink); margin-top: 1rem; max-width: 60ch; }
  .city-facts { list-style: disc; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; margin-top: 1rem; color: var(--muted); }
  .city-stats { display: grid; gap: 1.25rem; grid-template-columns: repeat(2, 1fr); margin-top: 1.25rem; }
  @media (min-width: 640px) { .city-stats { grid-template-columns: repeat(4, 1fr); } }
  .city-stat { background: var(--surface); border-radius: var(--r-card); padding: 1.5rem 1rem; text-align: center; font-size: 1rem; color: var(--muted); }
  .city-stat span { display: block; font-family: var(--font-heading); font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 700; color: var(--ink); line-height: 1; margin-bottom: 0.5rem; }
  .useful-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .useful-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .useful-grid { grid-template-columns: repeat(3, 1fr); } }
  .useful-card { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.25rem; border: 1px solid var(--border); border-radius: var(--r-card); background: var(--card); text-decoration: none; transition: border-color 0.15s, background 0.15s; }
  .useful-card:hover { border-color: var(--accent); background: var(--accent-tint); }
  .useful-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .useful-title { font-size: 1.25rem; font-weight: 700; color: var(--accent); }
  .useful-desc { font-size: 1rem; color: var(--muted); line-height: 1.45; }
  .uni-specialties { margin-bottom: 4rem; }
  .uni-specialties h3 { margin: 0 0 1.5rem; font-size: 1.25rem; }
  .specialty-grid { display: grid; gap: 1.25rem; grid-template-columns: 1fr; margin-top: 0; grid-auto-rows: 1fr; }
  @media (min-width: 640px) { .specialty-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .specialty-grid { grid-template-columns: repeat(3, 1fr); } }
  .specialty-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--r-card); padding: 1.25rem; display: flex; flex-direction: column; gap: 0.5rem; min-height: 180px; }
  .specialty-badge { display: inline-block; align-self: flex-start; padding: 0.25rem 0.6rem; border-radius: var(--r-btn); background: var(--accent-tint); color: var(--accent); font-weight: 700; font-size: 0.875rem; }
  .specialty-card h4 { font-size: 1.125rem; font-weight: 700; margin: 0.5rem 0 0; color: var(--ink); }
  .specialty-card p { color: var(--muted); font-size: 0.9375rem; line-height: 1.5; margin: 0; }
  .specialty-card .btn { margin-top: auto; align-self: flex-start; min-height: 44px; background: var(--accent); color: var(--vanilla); border-color: var(--accent); }
</style>