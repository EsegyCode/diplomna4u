---
interface Props {
  items: { title: string; subtitle?: string; href: string; ariaLabel?: string }[];
}
const { items } = Astro.props;
---
<div class="link-card-grid">
  {items.map((item, index) => (
    <a
      href={item.href}
      class={`link-card ${index % 4 === 3 ? 'link-card--sand' : ''}`}
      aria-label={item.ariaLabel || `${item.title}: докладніше`}
    >
      <span class="link-card-body">
        <span class="link-card-title">{item.title}</span>
        {item.subtitle && <span class="link-card-subtitle">{item.subtitle}</span>}
      </span>
      <span class="link-card-arrow" aria-hidden="true">→</span>
      <span class="sr-only">Докладніше</span>
    </a>
  ))}
</div>
<style>
  .link-card-grid {
    display: grid;
    gap: clamp(12px, 2vw, 20px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 480px) { .link-card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .link-card-grid { grid-template-columns: repeat(3, 1fr); } }

  .link-card {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: 88px; padding: 20px 22px;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 20px; text-decoration: none; color: var(--ink);
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }
  .link-card:hover, .link-card:focus-visible {
    border-color: var(--red); transform: translateY(-3px);
    box-shadow: 0 12px 28px -14px rgba(173,19,18,.35);
  }
  .link-card:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }

  .link-card-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .link-card-title {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(1.375rem, 3vw, 1.625rem);
    line-height: 1.1; color: var(--ink);
  }
  .link-card-subtitle {
    font-family: var(--font-body); font-weight: 400;
    font-size: clamp(0.9375rem, 1.8vw, 1rem);
    line-height: 1.4; color: var(--muted);
  }

  .link-card-arrow {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%;
    background: var(--sand); color: var(--red);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 1.25rem; font-weight: 700; transition: background 0.18s ease, color 0.18s ease;
  }
  .link-card:hover .link-card-arrow, .link-card:focus-visible .link-card-arrow { background: var(--red); color: var(--vanilla); }

  .link-card--sand { background: var(--sand); border-color: var(--sand); }
  .link-card--sand .link-card-title, .link-card--sand .link-card-subtitle { color: var(--red); }
  .link-card--sand .link-card-arrow { background: var(--vanilla); color: var(--red); }
  .link-card--sand:hover .link-card-arrow, .link-card--sand:focus-visible .link-card-arrow { background: var(--red); color: var(--vanilla); }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) {
    .link-card { transition: none; }
  }
</style>