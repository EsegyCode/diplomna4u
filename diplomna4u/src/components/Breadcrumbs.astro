---
interface Props {
  items: { label: string; href?: string }[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Хлібні крихти">
  <ol>
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span>{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumbs { margin-bottom: 20px; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; list-style: none; font-family: var(--font-body); font-size: clamp(0.875rem, 1.5vw, 0.9375rem); font-weight: 500; color: var(--muted); padding: 0; margin: 0; }
  .breadcrumbs li:not(:last-child)::after { content: '›'; margin-left: 0.25rem; color: var(--muted); }
  .breadcrumbs a { color: var(--red); text-decoration: none; }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs span { color: var(--ink); }
</style>
