---
import { prices } from '@/data/prices';
import { services } from '@/data/services';
const pricing = prices;
const factors = 'На ціну впливають: обсяг, спеціальність, унікальність і термін.';
function findService(w) { return services.find(s => s.slug === w.slug); }
function priceText(w) { return `${w.minPrice.toLocaleString('uk-UA').replace(/ /g, '\u00A0')}\u00A0грн`; }
---
<div class="pricing-wrap">
  <p class="pricing-factors">{factors}</p>
  <div class="pricing-table">
    <table class="pt" role="table">
      <thead class="pt-head" role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">Тип роботи</th>
          <th scope="col" role="columnheader">Що впливає на ціну</th>
          <th scope="col" role="columnheader">Ціна від</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {pricing.workTypes.map(w => (
          <tr role="row">
            <td role="cell">
              {(() => {
                const svc = findService(w);
                return svc ? (
                  <a href={`/poslugy/${w.slug}/`} class="work-type-link" aria-label={`${w.label}: детальніше`}>
                    {w.label}
                    <span class="arrow-chip" aria-hidden="true">→</span>
                  </a>
                ) : w.label;
              })()}
            </td>
            <td class="pt-factors" role="cell">{w.note ? w.note : ''}</td>
            <td class="pt-price" role="cell"><strong>{priceText(w)}</strong></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
<style>
  .pricing-wrap { width: 100%; }
  .pricing-factors {
    margin: 0 0 14px; padding: 14px 16px; border-radius: 16px;
    background: var(--sand); color: var(--red); font-size: 0.9375rem; line-height: 1.5; font-weight: 500;
  }
  .pricing-table { border: 1.5px solid var(--bloodstone); border-radius: var(--r-card); overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .pt { width: 100%; border-collapse: collapse; font-size: 1.05rem; }
  .pt th, .pt td { padding: 18px 22px; border-bottom: 1px solid var(--border); text-align: left; vertical-align: middle; }
  .pt thead { background: var(--bloodstone); color: var(--vanilla); }
  .pt th { color: var(--vanilla); font-weight: 700; font-size: 1.1rem; border-bottom: none; }
  .pt tbody tr:nth-child(even) { background: var(--surface); }
  .pt tbody tr:hover { background: rgba(159,178,172,0.18); }
  .pt-factors { font-size: 1rem; color: var(--muted); }
  .pt-price { width: 1%; white-space: nowrap; }
  .pt td strong { color: var(--bloodstone); font-weight: 700; font-size: 1.1rem; font-variant-numeric: lining-nums; }
  .pt td:first-child { min-width: 180px; white-space: normal; overflow-wrap: normal; word-break: normal; }

  .work-type-link { color: var(--ink); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
  .work-type-link:hover, .work-type-link:focus-visible { color: var(--red); }
  .work-type-link:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; border-radius: 4px; }
  .arrow-chip { width: 28px; height: 28px; border-radius: 50%; background: var(--sand); color: var(--red); display: inline-flex; align-items: center; justify-content: center; font-size: 0.9rem; font-weight: 700; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  /* mobile cards */
  @media (max-width: 719px) {
    .pricing-table { overflow: visible; }
    .pt-head { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    .pt, .pt tbody { display: block; width: 100%; }
    .pt tbody tr {
      display: grid; grid-template-columns: 1fr auto; grid-template-rows: auto auto;
      gap: 10px; align-items: baseline;
      background: var(--card); border: 1px solid var(--border); border-radius: 20px;
      padding: 18px 20px; margin-bottom: 12px; min-height: 84px;
    }
    .pt tbody tr:nth-child(even) { background: var(--card); }
    .pt td { display: block; border: none; padding: 0; }
    .pt td:nth-child(1) { grid-column: 1; grid-row: 1; }
    .pt td:nth-child(3) { grid-column: 2; grid-row: 1; text-align: right; white-space: nowrap; }
    .pt td:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    .pt td strong { font-size: 1.25rem; }
  }

  /* tablet */
  @media (min-width: 720px) and (max-width: 1023px) {
    .pt { min-width: 0; }
  }
</style>