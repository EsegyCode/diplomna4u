---
import { pricing } from '@/data/pricing';
---
<div class="pricing-table">
  <table class="pt">
<thead><tr><th>Тип роботи</th><th>Що впливає на ціну</th><th>Ціна від</th></tr></thead>
      <tbody>
        {pricing.workTypes.map(w => (
          <tr>
            <td>{w.label}</td>
            <td class="pt-factors">обсяг, спеціальність, унікальність, термін{w.note ? ` — ${w.note}` : ''}</td>
            <td><strong>{w.minPrice.toLocaleString('uk-UA')} грн</strong></td>
          </tr>
        ))}
      </tbody>
  </table>
</div>
<style>
  .pricing-table { border: 1.5px solid var(--bloodstone); border-radius: var(--r-card); overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .pt { min-width: 480px; }
  .pt { width: 100%; border-collapse: collapse; font-size: 1.05rem; }
  .pt th, .pt td { padding: 1rem 1.1rem; border-bottom: 1px solid var(--border); text-align: left; vertical-align: middle; min-height: 3rem; }
  .pt thead { background: var(--bloodstone); color: var(--qo-fg); }
  .pt th { color: var(--qo-fg); font-weight: 700; font-size: 1.1rem; border-bottom: none; }
  .pt tbody tr:nth-child(even) { background: var(--surface); }
  .pt tbody tr { transition: background 0.15s; }
  .pt tbody tr:hover { background: rgba(159, 178, 172, 0.18); }
  .pt-factors { font-size: 1rem; color: var(--muted); }
  .pt td strong { color: var(--bloodstone); font-weight: 700; font-size: 1.1rem; }
</style>
