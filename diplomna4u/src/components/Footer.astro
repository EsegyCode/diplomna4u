---
import { site } from '@/data/site';
import { footerGroups, ctaNav } from '@/data/navigation';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo-link" aria-label={site.brandUk}>
        <span class="footer-logo-pill">
          <img src="/logo.webp" alt={site.brandUk} width="44" height="44" loading="lazy" />
        </span>
        <span class="footer-logo-text">Diplomna 4 U</span>
      </a>
      <p class="footer-desc">{site.tagline} · {site.legal}</p>
      <p class="footer-meta">Графік: {site.schedule}</p>
      <p class="footer-meta">{site.zone}</p>
      {site.email && <p class="footer-meta"><a href={'mailto:' + site.email}>{site.email}</a></p>}
      <div class="footer-actions">
        {site.telegram && <a href={site.telegram.url} target="_blank" rel="noopener noreferrer" class="footer-btn footer-btn--solid">{site.telegram.label}</a>}
        <a href={ctaNav.href} class="footer-btn footer-btn--outline">{ctaNav.label}</a>
      </div>
    </div>

    {footerGroups.map((group) => (
      <div class="footer-col">
        <h4>{group.title}</h4>
        <ul>
          {group.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>

  <div class="container footer-bottom">
    <p>© {year} Дипломна 4 U. Усі права захищено.</p>
    <button type="button" class="footer-cookie-btn" id="cookieSettings">Змінити згоду</button>
  </div>
</footer>

<script>
  document.getElementById('cookieSettings')?.addEventListener('click', () => {
    (window as any).__openCookieBanner?.();
  });
</script>

<style>
  .site-footer {
    background: var(--bloodstone);
    color: var(--qo-fg);
    padding-block: 4rem 2rem;
    border-top: 2px solid var(--bloodstone);
  }
  @media (min-width: 900px) {
    .site-footer { padding-block: 6rem 3rem; }
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .footer-grid { grid-template-columns: 2.2fr 1fr 1fr 1fr 1fr; }
  }
  .footer-brand { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--qo-fg);
  }
  .footer-logo-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--qo-fg);
    border-radius: var(--r-card);
    padding: 0.4rem;
  }
  .footer-logo-pill img { display: block; width: auto; height: 40px; }
  .footer-logo-text { font-weight: 700; font-size: 1.35rem; color: var(--qo-fg); white-space: nowrap; }
  .footer-desc { max-width: 40ch; color: var(--qo-fg); opacity: 0.9; line-height: 1.5; }
  .footer-meta { font-size: 1rem; color: var(--qo-fg); opacity: 0.85; }
  .footer-meta a { color: var(--qo-fg); text-decoration: underline; }
  .footer-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }
  .footer-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.6rem 1.25rem;
    border-radius: var(--r-btn);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .footer-btn--solid { background: var(--qo-fg); color: var(--bloodstone); border: 2px solid var(--qo-fg); }
  .footer-btn--solid:hover { background: transparent; color: var(--qo-fg); }
  .footer-btn--outline { background: transparent; color: var(--qo-fg); border: 2px solid var(--qo-fg); }
  .footer-btn--outline:hover { background: var(--qo-fg); color: var(--bloodstone); }
  .footer-col h4 {
    margin-bottom: 0.9rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--qo-fg);
    position: relative;
  }
  .footer-col h4::after { content: ''; display: block; width: 2rem; height: 2px; background: var(--sage); margin-top: 0.4rem; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .footer-col a {
    color: var(--qo-fg);
    opacity: 0.88;
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.5;
    transition: color 0.15s, opacity 0.15s;
  }
  .footer-col a:hover { color: var(--sage); opacity: 1; text-decoration: underline; }
  .footer-bottom {
    background: var(--deep-2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 249, 235, 0.25);
    flex-wrap: wrap;
    color: var(--qo-fg);
    opacity: 0.85;
  }
  .footer-cookie-btn {
    background: none;
    border: 1px solid rgba(255, 249, 235, 0.6);
    color: var(--qo-fg);
    padding: 0.4rem 0.8rem;
    border-radius: var(--r-btn);
    cursor: pointer;
    font-size: 0.85rem;
  }
  .footer-cookie-btn:hover { background: rgba(255,249,235,0.12); }
</style>