---
interface Props {
  items: { title: string; desc: string; href: string }[];
}
const { items } = Astro.props;
---
<div class="section-link-grid">
  {items.map(it => (
    <a href={it.href} class="card section-link-card">
      <h3>{it.title}</h3>
      <p class="text-muted">{it.desc}</p>
      <span class="card-cta">Детальніше →</span>
    </a>
  ))}
</div>
<style>
  .section-link-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 600px) { .section-link-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .section-link-grid { grid-template-columns: repeat(4, 1fr); } }
  .section-link-card { display: flex; flex-direction: column; gap: 0.5rem; text-decoration: none; }
  .card-cta { margin-top: auto; font-weight: 600; color: var(--accent); }
</style>
