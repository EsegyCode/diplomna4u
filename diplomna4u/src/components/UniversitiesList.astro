---
import { cities } from '@/data/cities';
const ready = cities.filter(c => c.localContentReady);
---
<div class="universities-list">
  {ready.length === 0 ? (
    <p class="text-muted">Список університетів з'явиться після наповнення міст.</p>
  ) : ready.map(c => (
    <section class="uni-city">
      <h3>{c.name}</h3>
      <ul>{c.universities.map(u => <li>{u.name}{u.short?` (${u.short})`:''}</li>)}</ul>
      <a href={`/${c.slug}/`}>Сторінка міста →</a>
    </section>
  ))}
</div>
<style>
  .uni-city { margin-bottom: 2rem; }
  .uni-city ul { list-style: disc; padding-left: 1.25rem; display:flex; flex-direction:column; gap:0.3rem; }
</style>
