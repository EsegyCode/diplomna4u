---
import { legalMeta } from '@/data/legal';
interface Props { title: string }
const { title } = Astro.props;
---
<article class="legal-page container">
  <h1>{title}</h1>
  <p class="text-muted">Дата редакції: {legalMeta.editorDate || 'уточнюється власником'}.</p>
  <slot />
</article>
<style>
  .legal-page { max-width: 800px; padding-block: 2rem; }
  .legal-page h2 { margin-top: 1.5rem; }
  .legal-page p { margin: 0.75rem 0; }
  .legal-page ul { list-style: disc; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.3rem; }
</style>
