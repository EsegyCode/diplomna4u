---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---
<div class="benefit-chips">
  {items.map(t => (
    <div class="benefit-chip">
      <span class="benefit-dot" aria-hidden="true"></span>
      <span>{t}</span>
    </div>
  ))}
</div>
<style>
  .benefit-chips { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); align-items: stretch; }
  .benefit-chip {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 14px 18px; border-radius: 16px; min-height: 100%;
    background: var(--card);
    border: 1px solid color-mix(in srgb, var(--sand-deep) 40%, transparent);
    color: var(--ink);
    font-size: 1rem; font-weight: 500; line-height: 1.4;
    box-shadow: 0 2px 8px rgba(42,21,19,.06);
  }
  .benefit-dot {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
    background: var(--red);
  }
</style>