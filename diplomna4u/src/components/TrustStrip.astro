---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---
<div class="trust-panel">
  <div class="trust-strip">
    {items.map(t => <span class="trust-item"><span class="trust-dot" aria-hidden="true"></span>{t}</span>)}
  </div>
</div>
<style>
  .trust-panel {
    background: var(--bloodstone);
    border-radius: 28px;
    padding: 1.5rem;
    width: 100%;
  }
  .trust-strip { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; align-items: center; }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 249, 235, 0.1);
    color: var(--vanilla);
    border: 1.5px solid rgba(255, 249, 235, 0.35);
    padding: 0.6rem 1rem;
    border-radius: var(--r-btn);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    max-width: 100%;
    word-break: break-word;
  }
  .trust-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sage);
    flex-shrink: 0;
  }
  @media (min-width: 600px) {
    .trust-panel { padding: 2rem; border-radius: 32px; }
    .trust-item { font-size: 1.0625rem; }
  }
</style>
