---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---
<div class="trust-panel">
  <div class="trust-strip">
    {items.map(t => <span class="trust-item"><span class="trust-dot" aria-hidden="true"></span>{t}</span>)}
  </div>
</div>
<style>
  .trust-panel {
    background: var(--sage);
    border-radius: 24px;
    padding: clamp(20px, 3vw, 32px);
    width: 100%;
  }
  .trust-strip { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; align-items: center; }
  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    color: var(--deep);
    border: 1px solid color-mix(in srgb, var(--deep) 25%, transparent);
    padding: 14px 18px;
    border-radius: 16px;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    max-width: 100%;
    word-break: break-word;
  }
  .trust-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--deep);
    flex-shrink: 0;
  }
</style>
