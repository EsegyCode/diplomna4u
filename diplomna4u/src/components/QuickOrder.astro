---
import { pricing } from '@/data/pricing';

interface Props {
  variant?: 'hero' | 'compact' | 'page';
  defaultWork?: string;
  dark?: boolean;
}
const { defaultWork = '', dark = false } = Astro.props;

const pricingJson = JSON.stringify(pricing);
---
<div class={`quick-order card card--light${dark ? ' quick-order--dark' : ''}`} id="quick-order">
  <div class="qo-badge">Ціна від {pricing.workTypes.find(w=>w.slug==='dyplomna-robota')?.minPrice.toLocaleString('uk-UA')} грн</div>
  <h3 class="qo-title">Давайте уточнимо й безкоштовно проконсультуємо</h3>

  <form class="qo-form" data-qo>
    <input type="hidden" name="calc_payload" value="" />

    <!-- Step 1 -->
    <div class="qo-step qo-step-1">
      <div class="qo-row">
      <div class="field">
        <label>Тип роботи *</label>
        <select name="workType" data-work required>
          {pricing.workTypes.map(w => (
            <option value={w.slug} selected={defaultWork === w.slug || (defaultWork==='' && w.slug==='dyplomna-robota')}>{w.label}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label>Напрям *</label>
        <select name="subject" data-subject required>
          {pricing.subjects.map(s => <option value={s.id}>{s.label}</option>)}
        </select>
      </div>
      </div>
      <div class="field">
        <label>Тема роботи (необов'язково)</label>
        <input type="text" name="topic" />
      </div>
      <div class="field qo-pages" data-pages>
        <div class="pages-head">
          <label>Кількість сторінок</label>
          <div class="pages-value" data-pages-value>60 стор.</div>
        </div>
        <input type="range" name="pages" data-pages-range min="40" max="90" step="5" value="60" />
        <div class="range-labels">
          <span>40</span>
          <span>90</span>
        </div>
      </div>



      <div class="field">
        <label>Скільки часу до здачі</label>
        <div class="deadline-seg" data-deadline>
          {pricing.deadline.map((d, i) => (
            <button type="button" class={`seg-btn${i === 0 ? ' is-active' : ''}`} data-deadline-btn data-idx={i} aria-pressed={i === 0 ? 'true' : 'false'}>{d.label}</button>
          ))}
        </div>
        <p class="deadline-note">Чим раніше замовиш — тим вигідніше. Мінімальний термін дипломної — від 3 днів.</p>
      </div>

      <div class="field qo-addon" data-addon style="display:none">
        <label class="addon-label">
          <input type="checkbox" class="addon-check" name="addon" value="presentation-defense" data-addon-cb />
          <span>Презентація та підготовка до захисту (+2 000 грн)</span>
        </label>
      </div>

<div class="qo-footer">
        <div class="qo-price">
          <div class="price-display" data-price>—</div>
          <div class="qo-price-note">орієнтовна вартість, точну назве менеджер</div>
        </div>
        <button type="button" class="btn" data-next>Далі →</button>
      </div>
    </div>

    <!-- Step 2 -->
    <div class="qo-step qo-step-2" hidden>
      <input type="hidden" name="contact_type" data-contact-type value="" />
      <div class="field">
        <label>Ім'я *</label>
        <input type="text" name="qo_name" data-qo-name required />
      </div>
      <div class="field">
        <label>Telegram @username, телефон або email *</label>
        <input type="text" name="qo_contact" data-qo-contact required placeholder="@username, +380… або email" />
      </div>
      <div class="field">
        <label>Коментар (необов'язково)</label>
        <textarea name="qo_comment" rows="3" placeholder="Тема роботи, вимоги методички, побажання"></textarea>
      </div>
      <label class="consent">
        <input type="checkbox" class="consent-check" data-qo-consent required />
        <span>Погоджуюсь з <a href="/polityka-konfidentsiinosti/" target="_blank">політикою конфіденційності</a></span>
      </label>
      <div class="qo-actions">
        <button type="button" class="btn btn--ghost" data-back>← Назад</button>
        <button type="submit" class="btn">Відправити заявку</button>
      </div>
      <p class="form-status" data-qo-status aria-live="polite"></p>
    </div>
  </form>
</div>

<script define:vars={{ pricingJson }}>
  const pricing = JSON.parse(pricingJson);
  function calc(workSlug, subjectId, pages, deadlineIdx, addons) {
    const workType = pricing.workTypes.find(w => w.slug === workSlug);
    if (!workType) return null;
    const sc = pricing.subjectCoef[subjectId];
    if (sc === undefined) return null;
    const d = pricing.deadline[deadlineIdx];
    if (!d) return null;
    let base;
    if (workType.ratePerPage !== null && workType.hasPages) {
      base = Math.max(workType.minPrice, pages * workType.ratePerPage);
    } else {
      base = workType.minPrice;
    }
    let price = Math.round(base * sc * d.k);
    addons.forEach(id => {
      const a = pricing.addons.find(x => x.id === id);
      if (a && (!a.onlyFor || a.onlyFor.includes(workSlug))) price += a.price;
    });
    return price;
  }
  function fmt(n){ return n.toLocaleString('uk-UA') + '\u00a0грн'; }

  document.querySelectorAll('[data-qo]').forEach((form) => {
    const f = form;
    const root = f.closest('.quick-order');
    const workSel = f.querySelector('[data-work]');
    const subjectSel = f.querySelector('[data-subject]');
    const pagesBox = f.querySelector('[data-pages]');
    const pagesRange = f.querySelector('[data-pages-range]');
    const pagesValue = f.querySelector('[data-pages-value]');
    const addonBox = f.querySelector('[data-addon]');
    const addonCb = f.querySelector('[data-addon-cb]');
    const deadlineSeg = f.querySelector('[data-deadline]');
    const deadlineBtns = f.querySelectorAll('[data-deadline-btn]');
    const priceEl = f.querySelector('[data-price]');
    const hiddenCalc = f.querySelector('input[name="calc_payload"]');
    const nextBtn = f.querySelector('[data-next]');
    const backBtn = f.querySelector('[data-back]');
    const step1 = f.querySelector('.qo-step-1');
    const step2 = f.querySelector('.qo-step-2');
    const status = f.querySelector('[data-qo-status]');

    function workType() { const wt = pricing.workTypes.find(w => w.slug === workSel.value); return wt || pricing.workTypes[0]; }

    function applyWorkType() {
      const w = workType();
      if (w.hasPages) {
        pagesBox.style.display = '';
        if (pagesRange) pagesRange.value = '60';
        updatePagesValue();
      } else {
        pagesBox.style.display = 'none';
        if (pagesRange) pagesRange.value = '0';
        if (pagesValue) pagesValue.textContent = '—';
      }
      addonBox.style.display = w.slug === 'dyplomna-robota' ? '' : 'none';
    }

    function updatePagesValue() {
      if (!pagesRange || !pagesValue) return;
      const v = parseInt(pagesRange.value, 10) || 60;
      pagesValue.textContent = v === 0 ? '—' : v + ' стор.';
    }

    function getDeadlineIdx() {
      let idx = 0;
      deadlineBtns.forEach((btn, i) => { if (btn.classList.contains('is-active')) idx = i; });
      return idx;
    }

    function updatePrice() {
      const w = workSel.value;
      const subject = subjectSel.value;
      const pages = parseInt(pagesRange?.value || '0', 10) || 0;
      const di = getDeadlineIdx();
      const addons = addonCb && addonCb.checked ? ['presentation-defense'] : [];
      const p = calc(w, subject, pages, di, addons);
      if (p === null) { priceEl.textContent = 'Уточніть вартість у менеджера'; }
      else { priceEl.textContent = 'від ' + fmt(p); }
      updatePagesValue();
      // payload
      const payload = { workType: w, subject, pagesFrom: pagesRange ? pagesRange.value : '0', pagesTo: pagesRange ? pagesRange.value : '0', topic: (f.querySelector('input[name="topic"]'))?.value || '', deadline: pricing.deadline[di].id, addons, price: p };
      hiddenCalc.value = JSON.stringify(payload);
    }

    applyWorkType();
    updatePrice();
    workSel.addEventListener('change', () => { applyWorkType(); updatePrice(); });
    subjectSel.addEventListener('change', updatePrice);
    pagesRange?.addEventListener('input', () => { updatePagesValue(); updatePrice(); });
    deadlineBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        deadlineBtns.forEach(b => { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        updatePrice();
      });
    });
    addonCb?.addEventListener('change', updatePrice);

    nextBtn?.addEventListener('click', () => {
      // validate
      if (!workSel.value || !subjectSel.value) return;
      step1.hidden = true;
      step2.hidden = false;
    });
    backBtn?.addEventListener('click', () => {
      step2.hidden = true;
      step1.hidden = false;
    });

    function detectContactType(value) {
      const v = value.trim();
      if (/^@?[a-zA-Z0-9_]{5,32}$/.test(v)) return 'telegram';
      if (/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v)) return 'email';
      const digits = v.replace(/\\D/g, '');
      if (digits.length >= 10) return 'phone';
      return null;
    }

    f.addEventListener('submit', (e) => {
      e.preventDefault();
      // mock success
      const qName = f.querySelector('[data-qo-name]')?.value?.trim() || '';
      const qContact = f.querySelector('[data-qo-contact]')?.value?.trim() || '';
      const consent = f.querySelector('[data-qo-consent]');
      const contactType = detectContactType(qContact);
      const contactTypeInput = f.querySelector('[data-contact-type]');
      if (qName.length < 2 || !contactType || !consent?.checked) {
        if (status) status.textContent = contactType ? 'Перевірте обов\'язкові поля. Вкажи Telegram @username, телефон або email.' : 'Вкажи Telegram @username, телефон або email.';
        return;
      }
      if (contactTypeInput) contactTypeInput.value = contactType;
      const btn = f.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Відправляємо…'; }
      setTimeout(() => {
        if (status) status.textContent = 'Дякуємо! Ми зв\'яжемося з вами найближчим часом.';
        f.reset();
        applyWorkType();
        updatePrice();
        if (btn) { btn.disabled = false; btn.textContent = 'Відправити заявку'; }
        if (contactTypeInput) contactTypeInput.value = '';
        step2.hidden = true; step1.hidden = false;
      }, 800);
    });
  });
</script>
<style>
  .quick-order { position: relative; }
  .qo-badge {
    position: absolute; top: -12px; left: 1rem;
    background: var(--accent-tint); color: var(--accent); padding: 0.3rem 0.8rem;
    border-radius: var(--r-btn); font-weight: 600; font-size: 0.85rem;
  }
  .quick-order { padding: 1.25rem 1.5rem; }
  .qo-badge { font-size: 0.9rem; padding: 0.3rem 0.8rem; }
  .qo-row { display: grid; grid-template-columns: 1fr; gap: 0.7rem; }
  @media (min-width: 600px) { .qo-row { grid-template-columns: 1fr 1fr; } }
  .pages-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
  .pages-value { font-size: 2rem; font-weight: 700; color: var(--ink); line-height: 1; }
  .range-labels { display: flex; justify-content: space-between; font-size: 1rem; color: var(--muted); margin-top: 0.35rem; font-weight: 600; }
  .deadline-seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .seg-btn {
    min-height: 52px; padding: 0.6rem 0.5rem; border-radius: var(--r-btn);
    border: 2px solid var(--border); background: transparent; color: var(--ink);
    font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: all 0.2s;
  }
  .seg-btn.is-active { background: var(--accent); color: var(--card); border-color: var(--accent); }
  @media (max-width: 600px) { .deadline-seg { grid-template-columns: 1fr; } }
  .addon-label { display: inline-flex; align-items: center; gap: 0.75rem; font-weight: 600; font-size: 1.05rem; cursor: pointer; }
  .addon-check { width: 22px; height: 22px; accent-color: var(--accent); flex-shrink: 0; }
  .qo-title { margin-top: 0.35rem; margin-bottom: 0.85rem; font-size: 1.35rem; font-weight: 700; line-height: 1.2; }
  .qo-form .field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 0.85rem; }
  .qo-form label { font-weight: 600; font-size: 1.05rem; line-height: 1.25; }
  .qo-form input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
  .qo-form select,
  .qo-form textarea {
    background: var(--field-bg); border: 1px solid var(--field-border); border-radius: var(--r-input);
    padding: 0.6rem 0.85rem; width: 100%; font-size: 1.1rem; min-height: 48px;
  }
  .qo-form input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):focus,
  .qo-form select:focus,
  .qo-form textarea:focus {
    border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-tint); outline: none;
  }
.pills { display: inline-flex; border: 1px solid var(--border); border-radius: var(--r-btn); overflow: hidden; gap: 0; }
  .pill { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.5rem 0.9rem; border: none; border-radius: 0; cursor: pointer; font-weight: 500; }
  .pill input { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }
  .pill:has(input:checked) { background: var(--accent); color: var(--card); }
  .deadline-labels { display: flex; justify-content: space-between; font-size: 0.875rem; color: var(--muted); margin-top: 0.3rem; flex-wrap: wrap; gap: 0.25rem; }
  .deadline-note { font-size: 0.8rem; color: var(--muted); margin-top: 0.3rem; }
  .qo-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 0.9rem 0 0.3rem; flex-wrap: wrap; }
  .qo-price { text-align: left; margin: 0; min-width: 0; }
  .qo-price-note { font-size: 0.85rem; color: var(--muted); }
  .qo-price .price-display { font-size: clamp(1.6rem, 3.2vw, 2.2rem); }
  input[type="range"] { width: 100%; height: 8px; accent-color: var(--accent); }
  .qo-form .btn { min-height: 52px; font-size: 1rem; padding: 0.8rem 1.25rem; }

  .qo-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .qo-actions .btn--ghost { flex: 0 0 auto; min-width: 112px; }
  .qo-actions button[type="submit"] { flex: 1 1 200px; min-height: 52px; font-size: 1.1rem; }
  @media (max-width: 360px) { .qo-actions { flex-direction: column-reverse; } .qo-actions .btn { width: 100%; } }

  .consent { display: flex; align-items: center; gap: 0.75rem; cursor: pointer; font-size: 1.05rem; color: var(--qo-fg, var(--ink)); line-height: 1.35; }
  .consent-check { width: 20px; height: 20px; flex-shrink: 0; accent-color: var(--accent); border-radius: 6px; }
  .consent a { color: var(--qo-fg, var(--accent)); text-decoration: underline; }

  /* Inverted (dark) calculator variant */
  .quick-order--dark {
    --s-bg: var(--qo-bg);
    --s-fg: var(--qo-fg);
    --s-accent: var(--qo-fg);
    --s-on: var(--qo-bg);
    background: var(--qo-bg);
    color: var(--qo-fg);
    border-color: var(--qo-bg);
  }
  .quick-order--dark .qo-badge { background: var(--qo-badge-bg); color: var(--qo-badge-fg); }
  .quick-order--dark .qo-title { color: var(--qo-fg); }
  .quick-order--dark .qo-form label { color: var(--qo-fg); }
  .quick-order--dark .qo-form input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
  .quick-order--dark .qo-form select,
  .quick-order--dark .qo-form textarea {
    background: var(--field-bg); color: var(--ink); border-color: var(--field-border);
  }
  .quick-order--dark .qo-form input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):focus,
  .quick-order--dark .qo-form select:focus,
  .quick-order--dark .qo-form textarea:focus {
    border-color: var(--qo-fg); box-shadow: 0 0 0 3px var(--qo-focus); outline: none;
  }
  .quick-order--dark .pills { border-color: var(--qo-fg); }
  .quick-order--dark .pill { color: var(--qo-fg); }
  .quick-order--dark .pill:has(input:checked) { background: var(--qo-badge-bg); color: var(--qo-badge-fg); }
  .quick-order--dark .price-display { color: var(--qo-fg); }
  .quick-order--dark .qo-price-note,
  .quick-order--dark .deadline-labels,
  .quick-order--dark .deadline-note { color: var(--qo-fg); opacity: 0.85; }
  .quick-order--dark .consent { color: var(--qo-fg); }
  .quick-order--dark a { color: var(--qo-fg); text-decoration: underline; }
  .quick-order--dark .btn { background: var(--qo-badge-bg); color: var(--qo-badge-fg); border-color: var(--qo-badge-bg); }
  .quick-order--dark .btn:hover { background: transparent; color: var(--qo-badge-bg); }
  .quick-order--dark .btn--ghost { background: transparent; color: var(--qo-badge-bg); border-color: var(--qo-badge-bg); }
  .quick-order--dark .btn--ghost:hover { background: var(--qo-badge-bg); color: var(--qo-badge-fg); }
  .quick-order--dark .seg-btn { border-color: var(--qo-fg); color: var(--qo-fg); }
  .quick-order--dark .seg-btn.is-active { background: var(--qo-badge-bg); color: var(--qo-badge-fg); border-color: var(--qo-badge-bg); }
  .quick-order--dark .pages-value { color: var(--qo-fg); font-size: 2rem; }
  .quick-order--dark .range-labels { color: var(--qo-fg); opacity: 0.85; }
  .quick-order--dark input[type="range"] { accent-color: var(--qo-fg); }
  .quick-order--dark .addon-check { accent-color: var(--qo-fg); }
</style>

