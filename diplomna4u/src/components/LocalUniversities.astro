---
interface Props {
  universities: { name: string; short?: string; note?: string }[];
}
const { universities } = Astro.props;
---
<div class="local-universities">
  <h3>Університети міста</h3>
  {universities.length === 0 ? <p class="text-muted">Список буде додано.</p> : (
    <ul>
      {universities.map(u => <li>{u.name}{u.short ? ` (${u.short})` : ''}</li>)}
    </ul>
  )}
</div>
<style>
  .local-universities ul { list-style: disc; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
</style>
