---
import { cities } from '@/data/cities';
const ready = cities.filter(c => c.localContentReady);
---
<section class="cities-teaser">
  <div class="container">
    <h3 style="margin-bottom:1.5rem">Міста, з якими ми працюємо</h3>
    {ready.length === 0 ? (
      <p class="text-muted">Скоро додамо локальні сторінки міст.</p>
    ) : (
      <div class="chips">
        {ready.map(c => <a href={`/${c.slug}/`} class="chip">Дипломні роботи {c.inCity}</a>)}
      </div>
    )}

  </div>
</section>
