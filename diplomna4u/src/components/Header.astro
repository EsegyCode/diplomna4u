---
import { site, nav } from '@/data/site';
import { cities } from '@/data/cities';

const readyCities = cities.filter(c => c.localContentReady);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={site.brandUk}>
      <img src="/logo.webp" alt={site.brandUk} width="168" height="34" loading="eager" />
    </a>
    <div class="header-actions">
      <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="megaMenu" aria-label="Меню">
        <span aria-hidden="true">☰</span> Меню
      </button>
      <a href="/#quick-order" class="btn btn--sm">Дізнатись ціну</a>
    </div>
  </div>
  <div class="mega-menu" id="megaMenu" aria-hidden="true">
    <div class="container mega-grid">
      <div class="mega-col">
        <h3>Послуги</h3>
        {nav.services.map(s => (
          <a href={s.href}>{s.label}</a>
        ))}
      </div>
      <div class="mega-col">
        <h3>Компанія</h3>
        {nav.main.map(item => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
      <div class="mega-col">
        <h3>Де ми працюємо</h3>
        <a href="/mista/">Міста</a>
        <a href="/universytety/">Університети</a>
        <a href="/mista/" class="mega-all">Усі міста →</a>
      </div>
    </div>
    <button class="mega-close" id="menuClose" aria-label="Закрити меню" type="button">×</button>
  </div>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('megaMenu');
  const closeBtn = document.getElementById('menuClose');
  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-hidden', String(!open));
    if (open) {
      const first = menu.querySelector('a');
      first?.focus({ preventScroll: true });
    } else {
      btn.focus({ preventScroll: true });
    }
  }
  btn?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (!menu || !btn) return;
    const target = e.target as Node;
    if (menu.classList.contains('is-open') && !menu.contains(target) && !btn.contains(target)) {
      setOpen(false);
    }
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    justify-content: space-between;
  }
  .logo { display: inline-flex; align-items: center; text-decoration: none; }
  .logo img { display: block; width: auto; height: 34px; }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--r-btn);
    background: var(--card);
    color: var(--ink);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .menu-btn:hover { border-color: var(--accent); color: var(--accent); }
  .menu-btn:focus-visible { box-shadow: 0 0 0 3px var(--accent-tint); outline: none; }
  .mega-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateY(-8px);
    visibility: hidden;
    pointer-events: none;
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
    z-index: 950;
  }
  .mega-menu.is-open {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
  }
  .mega-grid {
    display: grid;
    gap: 2rem;
    padding-block: 1.5rem;
    grid-template-columns: repeat(3, 1fr);
  }
  .mega-col h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .mega-col a {
    display: block;
    color: var(--ink);
    text-decoration: none;
    padding: 0.35rem 0;
    font-size: 1rem;
  }
  .mega-col a:hover { color: var(--accent); text-decoration: underline; }
  .mega-col a:focus-visible { outline: none; box-shadow: 0 0 0 2px var(--accent-tint); border-radius: 4px; }
  .mega-all { font-weight: 600; color: var(--accent); }
  .mega-close {
    display: none;
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 1.5rem;
    min-width: 48px;
    min-height: 48px;
    color: var(--ink);
  }
  @media (max-width: 768px) {
    .mega-menu {
      position: fixed;
      inset: 0;
      top: 0;
      overflow: auto;
      padding-top: 1rem;
    }
    .mega-close { display: inline-flex; align-items: center; justify-content: center; }
    .mega-grid { grid-template-columns: 1fr; padding: 3.5rem 1.5rem 2rem; }
    .mega-col a { min-height: 48px; display: flex; align-items: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mega-menu { transition: none; transform: none; }
  }
</style>
