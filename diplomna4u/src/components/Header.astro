---
import { site, nav } from '@/data/site';
import { cities } from '@/data/cities';

const readyCities = cities.filter(c => c.localContentReady);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={site.brandUk}>{site.brandUk}</a>
    <button class="burger" aria-label="Меню" aria-expanded="false" id="burgerBtn">☰</button>
    <nav class="nav" id="mainNav" aria-label="Головне меню">
      <details class="nav-dropdown">
        <summary class="nav-link nav-summary">
          <a href="/poslugy/" class="nav-parent-link">Наші послуги</a>
          <span aria-hidden="true">▾</span>
        </summary>
        <ul class="dropdown-list">
          {nav.services.map(s => (
            <li><a href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </details>
      {nav.main.map(item => (
        <a href={item.href} class="nav-link">{item.label}</a>
      ))}
      <details class="nav-dropdown">
        <summary class="nav-link nav-summary">
          <a href="/mista/" class="nav-parent-link">Міста</a>
          <span aria-hidden="true">▾</span>
        </summary>
        <ul class="dropdown-list">
          {readyCities.length === 0 ? (
            <li class="dropdown-empty">Скоро</li>
          ) : readyCities.map(c => (
            <li><a href={`/${c.slug}/`}>{c.name}</a></li>
          ))}
          <li><a href="/mista/">Усі міста →</a></li>
        </ul>
      </details>
      <a href="/universytety/" class="nav-link">Університети</a>
      <a href={nav.cta.href} class="btn btn--sm">{nav.cta.label}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('burgerBtn');
  const nav = document.getElementById('mainNav');
  if (btn && nav) {
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!nav.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        nav.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav) {
      nav.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    background: var(--bg);
    border-bottom: 1px solid var(--tint);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    justify-content: space-between;
  }
  .logo { font-weight: 700; color: var(--deep); text-decoration: none; font-size: 1.1rem; }
  .burger { display: none; font-size: 1.5rem; }
  .nav { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .nav-link { color: var(--ink); text-decoration: none; padding: 0.5rem 0.75rem; font-weight: 500; }
  .nav-link:hover { color: var(--deep); }
  .nav-dropdown { position: relative; }
  .dropdown-list { list-style: none; position: absolute; top: 100%; left: 0; background: var(--bg); border: 1px solid var(--tint); border-radius: var(--r-card); padding: 0.5rem; min-width: 220px; display: none; z-index: 950; box-shadow: var(--shadow-card); }
  details[open] .dropdown-list { display: block; }
  .dropdown-list a { display: block; padding: 0.4rem 0.75rem; text-decoration: none; color: var(--ink); border-radius: 8px; }
  .dropdown-list a:hover { background: var(--tint); color: var(--deep); }
  .nav-summary { list-style: none; display: inline-flex; align-items: center; gap: 0.25rem; cursor: pointer; }
  .nav-summary::-webkit-details-marker { display: none; }
  .nav-parent-link { text-decoration: none; color: inherit; }
  .dropdown-empty { padding: 0.4rem 0.75rem; color: var(--muted); }
  @media (max-width: 900px) {
    .burger { display: block; }
    .nav { display: none; position: absolute; top: 64px; left: 0; right: 0; flex-direction: column; align-items: stretch; background: var(--bg); padding: 1rem; border-bottom: 1px solid var(--tint); }
    .nav.open { display: flex; }
    .dropdown-list { position: static; box-shadow: none; border: none; display: none; }
    details[open] .dropdown-list { display: block; }
  }
</style>
