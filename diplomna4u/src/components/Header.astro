---
import { site } from '@/data/site';
import { servicesNav, mainNav, ctaNav } from '@/data/navigation';

const pathname = Astro.url.pathname;
const norm = (p: string) => p.replace(/\/+$/, '') + '/';
const isActive = (href: string) => norm(pathname) === norm(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={site.brandUk}>
      <img src="/logo.webp" alt={site.brandUk} width="48" height="48" loading="eager" />
      <span class="logo-text">Diplomna 4 U</span>
    </a>

    <div class="header-actions">
      <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="megaMenu" aria-label="Меню">
        <span aria-hidden="true">☰</span> Меню
      </button>
      <a href={ctaNav.href} class="btn btn--sm">{ctaNav.label}</a>
    </div>
  </div>

  <div class="mega-menu" id="megaMenu" aria-hidden="true">
    <div class="container mega-panel">
      <nav aria-label="Головне меню">
        <details class="menu-group" open>
          <summary class="menu-summary">Послуги</summary>
          <ul class="menu-list">
            {servicesNav.map((s) => (
              <li><a href={s.href} class={isActive(s.href) ? 'is-active' : ''}>{s.label}</a></li>
            ))}
          </ul>
        </details>
        <ul class="menu-list menu-main">
          {mainNav.map((m) => (
            <li><a href={m.href} class={isActive(m.href) ? 'is-active' : ''}>{m.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
    <button class="mega-close" id="menuClose" aria-label="Закрити меню" type="button">×</button>
  </div>
</header>

<script>
  const btn = document.getElementById('menuBtn');
  const menu = document.getElementById('megaMenu');
  const closeBtn = document.getElementById('menuClose');
  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    menu.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-hidden', String(!open));
    if (open) {
      const first = menu.querySelector('a');
      first?.focus({ preventScroll: true });
    } else {
      btn.focus({ preventScroll: true });
    }
  }
  btn?.addEventListener('click', () => setOpen(!menu?.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.classList.contains('is-open')) setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (!menu || !btn) return;
    const target = e.target as Node;
    if (menu.classList.contains('is-open') && !menu.contains(target) && !btn.contains(target)) {
      setOpen(false);
    }
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 72px;
    justify-content: space-between;
  }
  .logo { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; }
  .logo img { display: block; width: auto; height: 48px; }
  .logo-text { font-weight: 700; font-size: 1.05rem; color: var(--ink); line-height: 1.1; white-space: nowrap; }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; flex-wrap: nowrap; }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--r-btn);
    background: var(--card);
    color: var(--ink);
    font-weight: 600;
    font-size: 1rem;
  }
  .menu-btn:hover { border-color: var(--accent); color: var(--accent); }
  .menu-btn:focus-visible { box-shadow: 0 0 0 3px var(--accent-tint); outline: none; }
  .mega-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateY(-8px);
    visibility: hidden;
    pointer-events: none;
    transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
    z-index: 950;
    box-shadow: var(--shadow-card);
  }
  .mega-menu.is-open {
    opacity: 1;
    transform: none;
    visibility: visible;
    pointer-events: auto;
  }
  .mega-panel { padding-block: 1.5rem; }
  .mega-panel nav { display: grid; gap: 1.5rem; }
  @media (min-width: 900px) { .mega-panel nav { grid-template-columns: 1fr 1fr; } }
  .menu-group { border: none; }
  .menu-summary {
    list-style: none;
    cursor: pointer;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    min-height: 48px;
    display: flex;
    align-items: center;
  }
  .menu-summary::-webkit-details-marker { display: none; }
  .menu-list { list-style: none; margin: 0; padding: 0; }
  .menu-list li a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-input);
    color: var(--ink);
    text-decoration: none;
    font-size: 1.125rem;
    transition: color 0.15s, background 0.15s;
  }
  .menu-list li a:hover { color: var(--accent); background: var(--accent-tint); }
  .menu-list li a.is-active { color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  .menu-list li a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .mega-close {
    display: none;
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    font-size: 1.5rem;
    min-width: 48px;
    min-height: 48px;
    color: var(--ink);
  }
  @media (max-width: 600px) {
    .header-inner { min-height: 64px; }
    .logo img { height: 40px; }
    .logo-text { font-size: 0.9rem; }
    .header-actions { gap: 0.5rem; }
    .menu-btn, .btn--sm { min-height: 44px; padding: 0.5rem 0.9rem; font-size: 0.9rem; }
  }
  @media (max-width: 768px) {
    .mega-menu {
      position: fixed;
      inset: 0;
      top: 0;
      overflow: auto;
      padding-top: 1rem;
    }
    .mega-close { display: inline-flex; align-items: center; justify-content: center; }
    .mega-panel nav { grid-template-columns: 1fr; padding: 3.5rem 1.5rem 2rem; }
    .menu-list li a { min-height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mega-menu { transition: none; transform: none; }
  }
</style>