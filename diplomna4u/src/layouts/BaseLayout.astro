---
import '../styles/global.css';
import { site } from '@/data/site';
import fs from 'node:fs';
import path from 'node:path';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import StickyContact from '@/components/StickyContact.astro';
import CookieBanner from '@/components/CookieBanner.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  jsonLd?: any[];
  locale?: string;
  lang?: string;
}
const {
  title,
  description = '',
  noindex = false,
  ogImage: ogImageProp,
  ogImageAlt = title,
  ogType = 'website',
  jsonLd = [],
  locale = 'uk_UA',
  lang = 'uk',
} = Astro.props;

const googleSiteVerification = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || '').trim();
const canonicalUrl = Astro.props.canonical ?? new URL(Astro.url.pathname, site.domain).href;

const ogSlug = Astro.url.pathname === '/' ? 'index' : Astro.url.pathname.replace(/^\/+|\/+$/g, '').replace(/\//g, '-');
const defaultOgFile = path.join(process.cwd(), 'public', 'og', ogSlug + '.png');
const ogImage = ogImageProp ?? (fs.existsSync(defaultOgFile) ? '/og/' + ogSlug + '.png' : '/og/og-default.png');
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, site.domain).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brandUk,
  alternateName: site.brand,
  url: site.domain,
  email: site.email,
  logo: new URL('/logo.png', site.domain).href,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    url: site.telegram?.url,
    email: site.email,
    availableLanguage: 'uk',
  },
  openingHours: 'Mo-Su 09:00-21:00',
  areaServed: { '@type': 'Country', name: 'Україна' },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brandUk,
  url: site.domain,
  inLanguage: lang,
};

const allJsonLd = [orgSchema, websiteSchema, ...jsonLd];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#6B0F1F" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.brandUk} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="RSS | Diplomna 4 U" href="/feed.xml" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {allJsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти до основного вмісту</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyContact />
    <CookieBanner />
  <script>
  import { initLeadForms } from '../scripts/lead-form.ts';
  initLeadForms();
</script>
</body>
</html>
---
<!-- script -->
---
